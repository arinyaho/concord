{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node \"$COPILOT_PLUGIN_ROOT/hooks/session-start.js\"",
        "windows": "node \"$env:COPILOT_PLUGIN_ROOT\\hooks\\session-start.js\"",
        "timeout": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node \"$COPILOT_PLUGIN_ROOT/hooks/user-prompt-submit.js\"",
        "windows": "node \"$env:COPILOT_PLUGIN_ROOT\\hooks\\user-prompt-submit.js\"",
        "timeout": 10
      }
    ]
  }
}